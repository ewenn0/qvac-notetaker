; Quiet `npm install` output. The deprecation warnings come exclusively from
; transitive sub-deps of `electron-builder` and `node-gyp` (old `glob`,
; `rimraf`, `inflight`, etc.) — they're install-time tooling that never ships
; in the built Electron app and we can't update them without breaking the
; build. Hiding them keeps the prune script's "freed N MB" line visible.
loglevel=warn
fund=false
audit=false

; As of @qvac/sdk 0.21 the SDK declares optional mobile peers (expo /
; react-native, via its host-prebuild support). react-native wants
; @types/react@^19, which conflicts with this Electron app's React 18 types and
; aborts a strict `npm install` with ERESOLVE. Those peers are mobile-only and
; never used here (we ship an Electron desktop build), so relax peer resolution
; to the pre-npm-7 behaviour. Scoped to this project via .npmrc so CI and clean
; installs are deterministic.
legacy-peer-deps=true
