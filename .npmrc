; Quiet `npm install` output. The deprecation warnings come exclusively from
; transitive sub-deps of `electron-builder` and `node-gyp` (old `glob`,
; `rimraf`, `inflight`, etc.) — they're install-time tooling that never ships
; in the built Electron app and we can't update them without breaking the
; build. Hiding them keeps the prune script's "freed N MB" line visible.
loglevel=warn
fund=false
audit=false
